# =============================================================================
# Environment template — copy to .env.local for local development.
# For production, set the same NAMES in Netlify → Site configuration → Environment variables.
# NEVER commit real secrets. NEVER prefix service-role keys with NEXT_PUBLIC_.
# =============================================================================

# --- REQUIRED (PUBLIC) ---
# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mapbox public (browser) token — restrict by URL in Mapbox account settings
# https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- REQUIRED (SERVER ONLY) ---
# Supabase Project Settings → API → service_role (secret)
# Used only in Next.js server routes for Auth user provisioning.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- STRONGLY RECOMMENDED (PUBLIC) ---
# Canonical site origin used for password-reset redirect links.
# Example Netlify: https://your-site.netlify.app
# Example custom:  https://app.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated platform hostnames that must never resolve as tenant domains.
# Include your production app hostname(s). *.netlify.app / *.vercel.app are already blocked in code.
# NEXT_PUBLIC_PLATFORM_HOSTS=app.yourdomain.com,www.yourdomain.com

# --- OPTIONAL / LOCAL FALLBACK ---
# Usually unused when NEXT_PUBLIC_SUPABASE_URL is set (service client uses that URL).
# SUPABASE_URL=http://127.0.0.1:54321

# --- OPTIONAL: Custom domain DNS / hosting automation ---
# Defaults in production: DNS_PROVIDER=none, HOSTING_PROVIDER=none (manual DNS instructions).
# DNS_PROVIDER=mock|cloudflare|none
# CUSTOM_DOMAIN_TARGET=your-netlify-site.netlify.app
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# HOSTING_PROVIDER=mock|vercel|none
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Local *.localhost domain verify shortcut (development only)
# DOMAIN_ALLOW_LOCALHOST_VERIFY=true
