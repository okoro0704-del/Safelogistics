# Public (safe for frontend)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mapbox public token (client-side). Required for interactive route maps.
# Create a token at https://account.mapbox.com/ — do not commit real credentials.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional platform origin (password reset links, primary URL fallback)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: comma-separated platform hostnames that must never resolve as tenants
# NEXT_PUBLIC_PLATFORM_HOSTS=app.routeledger.com,www.routeledger.com

# Server-only — NEVER expose to the browser / NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=http://127.0.0.1:54321

# --- Custom domains / DNS provisioning (Prompt 12) ---
# DNS_PROVIDER=mock|cloudflare|none
#   mock      — local/dev only (default in development)
#   cloudflare — automatic DNS via Cloudflare API
#   none      — manual DNS instructions only (default in production if unset)
# DNS_PROVIDER=mock

# Hostname where custom domains should CNAME (or ALIAS at apex)
# CUSTOM_DOMAIN_TARGET=cname.vercel-dns.com

# Cloudflare (when DNS_PROVIDER=cloudflare)
# Required token permissions: Zone → DNS → Edit (scoped)
# CLOUDFLARE_API_TOKEN=
# Optional fixed zone; otherwise zone is resolved by domain name
# CLOUDFLARE_ZONE_ID=

# Hosting attachment (application must receive the hostname)
# HOSTING_PROVIDER=mock|vercel|none
# HOSTING_PROVIDER=mock

# Vercel (when HOSTING_PROVIDER=vercel)
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Local custom-domain verify for *.localhost (default true in development)
# DOMAIN_ALLOW_LOCALHOST_VERIFY=true
